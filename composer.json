{
    "name": "fairbearlab/planning-poker",
    "description": "Blind planning poker — dev-only tooling. Runtime ships as plain PHP files with zero dependencies.",
    "license": "proprietary",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload-dev": {
        "files": [
            "db.php",
            "store.php",
            "stats.php",
            "api.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true
    }
}
